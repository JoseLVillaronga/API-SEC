# Ejemplo de configuración para API-SEC (renombra a .env)
# Ajusta los valores según tu entorno. No subas .env a control de versiones.

# Dirección/puerto de escucha del proxy
IP_BIND=0.0.0.0
PORT_BIND=8010

# Destino al que se reenviarán las solicitudes (listener)
IP_LISTENER=127.0.0.1
PORT_LISTENER=11434

# Autenticación (token de ejemplo, reemplázalo por uno real y seguro)
API_KEY=change-me-super-secret-token

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/proxy.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Características
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

